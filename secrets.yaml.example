# secrets.yaml.example
#
# Copy this file to `secrets.yaml` and fill in real values.
# `secrets.yaml` is in .gitignore and must NEVER be committed.
#
# Every device YAML in this repo references these via `!secret <key>`,
# so all keys below must exist (with real values) before flashing.

# ─── WiFi credentials (used by every device) ─────────────────────────
wifi_ssid: "YourWiFiNetwork"
wifi_password: "your-wifi-password"

# ─── Fallback recovery AP password ───────────────────────────────────
# Used when the device cannot reach your WiFi. The device broadcasts an
# AP named "<device_name> Fallback" that you connect your phone to in
# order to reconfigure WiFi via captive portal. Anything 8+ characters.
fallback_password: "fallback-12-chars-or-more"

# ─── Encrypted Home Assistant ↔ device API channel ───────────────────
# 32 random bytes, base64-encoded (44 characters ending in '=').
# Generate one with PowerShell (no external tools required):
#
#   $b = New-Object byte[] 32
#   [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
#
# You can use the same key for every device on your trusted LAN.
api_encryption_key: "GENERATE-44-CHAR-BASE64-KEY-HERE="

# ─── OTA firmware-update password ────────────────────────────────────
# Used by ESPHome Builder when pushing wireless firmware updates.
# You only enter this once per device when first pairing.
ota_password: "ota-password-here"

# ─── Local web UI HTTP basic auth ────────────────────────────────────
# Protects the device's own monitoring page on http://<device>.local/.
# This is HTTP basic auth over plain HTTP (no TLS on ESP8266) — fine on
# trusted LAN, never expose to the internet.
web_username: "admin"
web_password: "web-ui-password-here"
